

import java.awt.*; // Import AWT classes
import javax.swing.*; // Import Swing classes
import javax.swing.event.*; // Import Swing event classes

public class B19_Slider {

    public static void main(String[] args) {

        // JSlider = GUI component that lets user enter a value 
        //           by using an adjustable sliding knob on a track

        SliderDemo sliderDemo = new SliderDemo(); // Create an instance of SliderDemo to display the GUI
    }

}

class SliderDemo implements ChangeListener {

    JSlider slider; // Declare a JSlider
    JFrame frame; // Declare a JFrame
    JPanel panel; // Declare a JPanel
    JLabel label; // Declare a JLabel

    public SliderDemo() {

        frame = new JFrame("Slider Demo"); // Initialize JFrame with title
        panel = new JPanel(); // Initialize JPanel
        label = new JLabel(); // Initialize JLabel
        slider = new JSlider(0, 100, 50); // Initialize JSlider with min, max, and initial value

        slider.setPreferredSize(new Dimension(400, 200)); // Set preferred size of the slider

        slider.setPaintTicks(true); // Enable painting of tick marks on the slider
        slider.setMinorTickSpacing(10); // Set minor tick spacing to 10

        slider.setPaintTrack(true); // Enable painting of the track
        slider.setMajorTickSpacing(25); // Set major tick spacing to 25

        slider.setPaintLabels(true); // Enable painting of labels on the slider
        label.setFont(new Font("MV Boli", Font.PLAIN, 15)); // Set font for the label

        slider.setOrientation(SwingConstants.VERTICAL); // Set orientation of the slider to vertical

        label.setText("C = " + slider.getValue()); // Set initial text for the label to the slider's value
        slider.addChangeListener(this); // Add change listener to the slider

        panel.add(slider); // Add slider to the panel
        panel.add(label); // Add label to the panel
        frame.add(panel); // Add panel to the frame

        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE); // Set default close operation
        frame.setSize(500, 500); // Set frame size
        frame.setVisible(true); // Make the frame visible

    }

    @Override
    public void stateChanged(ChangeEvent e) { // Method called when the state of the slider changes
        label.setText("C = " + slider.getValue()); // Update the label text with the slider's current value
    }

}
