package Warmup;

public class Warmup1 {

	public static void main(String[] args) {

		boolean found = sleepIn(false, true);
		
		System.out.println(found);
		
		
	}

	static boolean sleepIn(boolean weekday, boolean vacation) {
		
		boolean found = false;
		
		if (!weekday || !vacation) {
			return found = true;
		} else if (!weekday || vacation) {
			return found = true;
		} else if (weekday || !vacation) {
			return found = false;
		} else {
			return = false;
		}
		
		
		return found;
	}
	
}
