package Easy;

import java.util.*;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.io.*;

class Easy1 {

	public static void main(String[] args) {
		// keep this function call here
		Scanner s = new Scanner(System.in);
		System.out.print("Username: ");
		String username = s.nextLine();

		
		boolean isValid = CodelandUsernameValidation(username);
		System.out.println("Output: " + isValid);

		register(username, isValid);
		
		s.close();
	}

	static boolean CodelandUsernameValidation(String str) {

		Pattern pattern = Pattern.compile("(^[a-zA-Z])([a-zA-Z_0-9]{2,24}$)");
		Matcher matcher = pattern.matcher(str);

		return matcher.find() && matcher.group().equals(str);
	}

	static void register(String username, boolean isValid) {
		if (!isValid) {
			System.out.println("not regis");
		}
		
		
	}
}